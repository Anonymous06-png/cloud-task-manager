# Django Application Configuration
# Copy this file to .env and fill in actual values:  Copy-Item .env.example .env
# Required variables: SECRET_KEY and POSTGRES_PASSWORD. Compose fails fast
# (with a clear message) if either is unset or empty.

# Django Settings
# SECRET_KEY is required and must not be blank. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-with-a-generated-secret

# Runtime environment: 'local' (plain HTTP on 127.0.0.1) or 'production'
# (HTTPS terminated by the reverse proxy). Defaults to 'production' if unset.
DJANGO_ENV=local

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
POSTGRES_DB=taskmanager
POSTGRES_USER=taskuser
# POSTGRES_PASSWORD is required and must not be blank.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Constructed DATABASE_URL (used by Django). Host 'db' is the internal
# Docker Compose service name; use a reachable host for non-container runs.
DATABASE_URL=postgresql://taskuser:replace-with-a-strong-password@db:5432/taskmanager

# Security Settings
# Local development serves plain HTTP: keep False here. Production (HTTPS)
# must set SECURE_SSL_REDIRECT=True. The /health/ endpoint is always exempt
# from SSL redirect so internal health probes can poll it over HTTP.
SECURE_SSL_REDIRECT=False
